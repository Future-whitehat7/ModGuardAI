# Application Settings
APP_NAME=ModGuardAI API
VERSION=1.0.0
DEBUG=True

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/modguardai

# CORS (comma-separated list)
# For local development with Expo
BACKEND_CORS_ORIGINS=["http://localhost:19000", "http://localhost:19001", "exp://localhost:19000", "http://localhost:8081"]

# AWS (Optional - for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=modguardai-media

# Stripe (Optional - for payments)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis (Optional - for caching and task queue)
REDIS_URL=redis://localhost:6379

# ML Models
MODEL_PATH=./ml_models
VIDEO_MODEL_PATH=./ml_models/video_detector.pkl
AUDIO_MODEL_PATH=./ml_models/audio_detector.pkl
IMAGE_MODEL_PATH=./ml_models/image_detector.pkl

# File Upload Limits
MAX_FILE_SIZE=104857600
