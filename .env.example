# Names only. Do not put real secrets in this file or in git.
# Set preview and production values separately in the Netlify UI.

# preview or production. Preview rejects live-mode Stripe events.
APP_ENV=

# Webhook signing secret for this environment's endpoint. Not the Stripe secret key.
STRIPE_WEBHOOK_SECRET=

# plink_ id of the existing payment link https://buy.stripe.com/28E6oIgDKc8S8NfdAD4ZG07
STRIPE_PAYMENT_LINK_ID=

# Operator API bearer token. Server only.
OPERATOR_TOKEN=

# Set to 1 on preview only, to allow the isolated test intake namespace.
ALLOW_TEST_NAMESPACE=

# Optional. Delivery records readiness and does not send unless all three are set.
RESEND_API_KEY=
RESEND_FROM=
DELIVERY_SEND_ENABLED=
