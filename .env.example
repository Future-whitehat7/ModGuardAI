# Names only. Do not put real secrets in this file or in git.
# Set preview and production values separately in the Netlify UI.

# preview or production. Preview rejects live-mode Stripe events.
# On the production site this must be the word production. If CONTEXT=production and APP_ENV is empty,
# the webhook refuses the event and logs the miss instead of quietly treating the deploy as preview.
APP_ENV=

# Webhook signing secret for this environment's endpoint. Not the Stripe secret key.
STRIPE_WEBHOOK_SECRET=

# plink_ id of the existing payment link https://buy.stripe.com/28E6oIgDKc8S8NfdAD4ZG07
STRIPE_PAYMENT_LINK_ID=

# Operator API bearer token. Server only. Also unlocks the /operator page.
OPERATOR_TOKEN=

# Comma-separated. When an order is paid, each address gets its own copy of the intake.
# Example: owner@example.com, second-operator@example.com
# Not required for the customer email.
OPERATOR_EMAIL=

# Optional absolute origin for the private status link, with no path. Falls back to Netlify URL.
PUBLIC_SITE_URL=

# Shared secret the webhook sends to the background research function. Required for research to start.
RESEARCH_TRIGGER_TOKEN=

# Set to 1 on preview only, to allow the isolated test intake namespace.
ALLOW_TEST_NAMESPACE=

# Customer and operator email send only when all three are set. Otherwise the miss is stored on the order.
RESEND_API_KEY=
RESEND_FROM=
DELIVERY_SEND_ENABLED=
